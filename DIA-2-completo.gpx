<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Roadbook Canos de Meca" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>DIA 2 completo</name>
    <desc>Dia 2 completo: Los Canos de Meca - La Carlota.</desc>
  </metadata>
  <rte>
    <name>D2 E1 Los Canos - San Jose del Valle</name>
    <desc>Vejer, Medina Sidonia y Paterna de Rivera.</desc>
    <rtept lat="36.18670" lon="-6.02640"><name>Los Canos de Meca</name></rtept>
    <rtept lat="36.24456" lon="-5.96953"><name>Vejer de la Frontera</name></rtept>
    <rtept lat="36.45695" lon="-5.92717"><name>Medina Sidonia</name></rtept>
    <rtept lat="36.52246" lon="-5.86578"><name>Paterna de Rivera</name></rtept>
    <rtept lat="36.60554" lon="-5.79895"><name>San Jose del Valle</name></rtept>
  </rte>
  <rte>
    <name>D2 E2 San Jose del Valle - Montellano</name>
    <desc>Algar, Arcos, Bornos y Villamartin. Parada larga en Arcos.</desc>
    <rtept lat="36.60554" lon="-5.79895"><name>San Jose del Valle</name></rtept>
    <rtept lat="36.65748" lon="-5.65558"><name>Algar</name></rtept>
    <rtept lat="36.75075" lon="-5.81056"><name>Arcos de la Frontera</name></rtept>
    <rtept lat="36.81677" lon="-5.74448"><name>Bornos</name></rtept>
    <rtept lat="36.85979" lon="-5.64485"><name>Villamartin</name></rtept>
    <rtept lat="36.99531" lon="-5.57145"><name>Montellano</name></rtept>
  </rte>
  <rte>
    <name>D2 E3 Montellano - La Carlota</name>
    <desc>Moron, Marchena y Ecija. Ultimo repostaje en Ecija si hace falta.</desc>
    <rtept lat="36.99531" lon="-5.57145"><name>Montellano</name></rtept>
    <rtept lat="37.12084" lon="-5.45403"><name>Moron de la Frontera</name></rtept>
    <rtept lat="37.32900" lon="-5.41681"><name>Marchena</name></rtept>
    <rtept lat="37.54220" lon="-5.08260"><name>Ecija</name></rtept>
    <rtept lat="37.67359" lon="-4.93122"><name>La Carlota</name></rtept>
  </rte>
</gpx>
