<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Roadbook Canos de Meca" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>DIA 1 completo</name>
    <desc>Dia 1 completo: La Carlota - Los Canos de Meca.</desc>
  </metadata>
  <rte>
    <name>D1 E1 La Carlota - Algodonales</name>
    <desc>Salida 07:00. Ecija, Marchena, Moron, Montellano, Puerto Serrano.</desc>
    <rtept lat="37.67359" lon="-4.93122"><name>La Carlota</name></rtept>
    <rtept lat="37.54220" lon="-5.08260"><name>Ecija</name></rtept>
    <rtept lat="37.32900" lon="-5.41681"><name>Marchena</name></rtept>
    <rtept lat="37.12084" lon="-5.45403"><name>Moron de la Frontera</name></rtept>
    <rtept lat="36.99531" lon="-5.57145"><name>Montellano</name></rtept>
    <rtept lat="36.92209" lon="-5.54304"><name>Puerto Serrano</name></rtept>
    <rtept lat="36.88044" lon="-5.40536"><name>Algodonales</name></rtept>
  </rte>
  <rte>
    <name>D1 E2 Algodonales - Ronda</name>
    <desc>Sierra de Grazalema. Zahara y Puerto de las Palomas hacia Grazalema, luego A-372 y A-374.</desc>
    <rtept lat="36.88044" lon="-5.40536"><name>Algodonales</name></rtept>
    <rtept lat="36.84055" lon="-5.39128"><name>Zahara de la Sierra</name></rtept>
    <rtept lat="36.76018" lon="-5.36839"><name>Grazalema</name></rtept>
    <rtept lat="36.74231" lon="-5.16709"><name>Ronda</name></rtept>
  </rte>
  <rte>
    <name>D1 E3 Ronda - Gaucin</name>
    <desc>A-369 por el valle del Genal. Atajate y Algatocin fijan la carretera; Benadalid queda de paso.</desc>
    <rtept lat="36.74231" lon="-5.16709"><name>Ronda</name></rtept>
    <rtept lat="36.64017" lon="-5.24606"><name>Atajate</name></rtept>
    <rtept lat="36.57356" lon="-5.27554"><name>Algatocin</name></rtept>
    <rtept lat="36.51784" lon="-5.31581"><name>Gaucin</name></rtept>
  </rte>
  <rte>
    <name>D1 E4 Gaucin - Alcala de los Gazules</name>
    <desc>A-405 por Jimena. Sin Puerto de Galiz. Comprobar estado de la A-405 antes del viaje.</desc>
    <rtept lat="36.51784" lon="-5.31581"><name>Gaucin</name></rtept>
    <rtept lat="36.43517" lon="-5.45387"><name>Jimena de la Frontera</name></rtept>
    <rtept lat="36.46212" lon="-5.72382"><name>Alcala de los Gazules</name></rtept>
  </rte>
  <rte>
    <name>D1 E5 Alcala - Los Canos de Meca</name>
    <desc>Medina Sidonia y Vejer. Llegada prevista 18:30-19:30.</desc>
    <rtept lat="36.46212" lon="-5.72382"><name>Alcala de los Gazules</name></rtept>
    <rtept lat="36.45695" lon="-5.92717"><name>Medina Sidonia</name></rtept>
    <rtept lat="36.24456" lon="-5.96953"><name>Vejer de la Frontera</name></rtept>
    <rtept lat="36.18670" lon="-6.02640"><name>Los Canos de Meca</name></rtept>
  </rte>
</gpx>
